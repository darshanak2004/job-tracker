# Copy to .env  ->  cp .env.example .env     (.env is git-ignored, never commit real secrets)

# --- PostgreSQL ---
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker

# --- Backend ---
# At least 32 characters. Generate one:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-1234
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8080

# --- Frontend ---
# URL the BROWSER uses to reach the backend (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000
